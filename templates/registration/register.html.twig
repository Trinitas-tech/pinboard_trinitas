{% extends 'base.html.twig' %}

{% block title %}Inscription - PinBoard{% endblock %}

{% block body %}
    <section class="container form-page">
        <h1 class="h2 mb-4">S'inscrire</h1>
        {{ form_start(registrationForm) }}
            {{ form_row(registrationForm.firstname) }}
            {{ form_row(registrationForm.lastname) }}
            {{ form_row(registrationForm.email) }}
            {{ form_row(registrationForm.imageName) }}
            {{ form_row(registrationForm.plainPassword) }}
            <button class="btn btn-danger mt-2" type="submit">Creer mon compte</button>
        {{ form_end(registrationForm) }}
    </section>
{% endblock %}
