{% extends 'base.html.twig' %}

{% block title %}Mon profil - PinBoard{% endblock %}

{% block body %}
    <section class="container">
        <div class="profile-header">
            <img
                src="{{ user.imageName }}"
                alt="{{ user.firstname }} {{ user.lastname }}"
                referrerpolicy="no-referrer"
                onerror="this.onerror=null;this.src='https://ui-avatars.com/api/?name={{ (user.firstname ~ ' ' ~ user.lastname)|url_encode }}&background=dc3545&color=fff&size=300';"
            >
            <div>
                <h1 class="h2 mb-1">{{ user.firstname }} {{ user.lastname }}</h1>
                <p class="text-muted mb-3">Compte cree le {{ user.createdAt|date('d/m/Y') }}</p>
                <a class="btn btn-danger" href="{{ path('app_account_edit') }}">Editer</a>
            </div>
        </div>
    </section>
{% endblock %}
