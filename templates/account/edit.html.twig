{% extends 'base.html.twig' %}

{% block title %}Modifier mon profil - PinBoard{% endblock %}

{% block body %}
    <section class="container form-page">
        <h1 class="h2 mb-4">Modifier mon profil</h1>
        {{ form_start(form) }}
            {{ form_row(form.firstname) }}
            {{ form_row(form.lastname) }}
            {{ form_row(form.imageName) }}
            <div class="d-flex gap-2 mt-3">
                <button class="btn btn-danger" type="submit">Enregistrer</button>
                <a class="btn btn-outline-dark" href="{{ path('app_account') }}">Retour</a>
            </div>
        {{ form_end(form) }}
    </section>
{% endblock %}
